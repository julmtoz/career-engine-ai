# Copy this file to .env for local dev, and set the same keys in Vercel
# (Project Settings → Environment Variables) for deployed environments.
# Never commit the real .env — it's gitignored.

# ---------- Supabase ----------
# Server-side (used by SSR / server functions via process.env)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service role key — bypasses RLS. Server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Client-side (Vite build-time injection). Same project as above.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------- Lovable AI Gateway ----------
LOVABLE_API_KEY=

# ---------- Gmail OAuth (Google Cloud Console) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI configured on the Google OAuth client,
# e.g. https://your-app.vercel.app/auth/callback/gmail
GOOGLE_REDIRECT_URI=

# ---------- Resend (transactional email) ----------
RESEND_API_KEY=
FROM_EMAIL=noreply@your-domain.com
FROM_NAME=Aether OS
